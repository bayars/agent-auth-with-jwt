# ── Copy to .helm.env and fill in all values ─────────────────────────────────
# .helm.env is gitignored. Never commit real secrets.

# Docker image registry and tag
IMAGE_REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest

# Kubernetes namespace (all components except cert-manager go here)
NAMESPACE=sso-mcp

# ── Keycloak ──────────────────────────────────────────────────────────────────
KC_ADMIN_PASSWORD=change-me-strong-password
KC_DB_HOST=your-postgres.postgres.database.azure.com   # Azure DB / Cloud SQL host
KC_DB_PASSWORD=change-me-db-password
# Public URL Keycloak uses in token iss claims
KC_EXTERNAL_URL=https://auth.example.com

# ── Application ───────────────────────────────────────────────────────────────
APP_HOST=app.example.com

# ── Secrets (set after first Keycloak start) ──────────────────────────────────
# 1. Start Keycloak:  source .helm.env && helmfile sync --selector name=keycloak
# 2. Run:            ./scripts/get-service-token.sh
# 3. Paste here:
MCP_SERVICE_TOKEN=
FASTMCP_SERVICE_CLIENT_SECRET=fastmcp-service-secret-change-me
OPENCODE_SERVER_PASSWORD=change-me-opencode-password

# ── AI (Ollama) ───────────────────────────────────────────────────────────────
OLLAMA_URL=http://10.0.0.224:11434
OLLAMA_EMBED_MODEL=qwen2.5:1.5b
# Anthropic API key — optional when using Ollama
ANTHROPIC_API_KEY=
