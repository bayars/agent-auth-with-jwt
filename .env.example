# AI provider key required by OpenCode
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Password for OpenCode's built-in HTTP basic auth
# Used by the Next.js proxy when forwarding requests to the OpenCode container
OPENCODE_SERVER_PASSWORD=change-me-strong-password

# Keycloak client secret for the fastmcp-service client (confidential client)
# Used for server-to-server MCP calls from OpenCode → Next.js proxy → FastMCP
# Obtain after first docker compose run:
#   ./scripts/get-service-token.sh
# Then paste the printed client secret here:
FASTMCP_SERVICE_CLIENT_SECRET=

# Access token for OpenCode → FastMCP MCP connection (server-to-server leg)
# Obtain by running: ./scripts/get-service-token.sh  (after filling FASTMCP_SERVICE_CLIENT_SECRET)
MCP_SERVICE_TOKEN=
